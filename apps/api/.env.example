NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

DATABASE_URL=postgresql://lsp:lsp@localhost:5432/lsp_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_COOKIE_NAME=lsp_refresh

CORS_ORIGIN=http://localhost:5173

# Reverse-proxy hops in front of Express (production Vercel→Render = 2; local dev = 0).
# Makes req.ip the real client for rate limiting + audit logs.
TRUST_PROXY_HOPS=0

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REFRESH_MAX=30

# Unpaid /stay bookings auto-cancel after this many hours (0 disables).
WEBSITE_PENDING_TTL_HOURS=24

# Dead (expired/revoked) refresh tokens are pruned after this many days (0 disables).
REFRESH_TOKEN_RETENTION_DAYS=30
# Audit history to KEEP, in days — 0 keeps it forever (pruning is an owner decision).
AUDIT_LOG_RETENTION_DAYS=0

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=

BCRYPT_ROUNDS=12
LOG_LEVEL=info

# Sentry error tracking (API). Leave empty to keep it off.
SENTRY_DSN=
