VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=Lifestyle Operations Platform
VITE_APP_VERSION=1.0.0

# Public guest booking site (lsp-book). Used to build the in-apartment
# check-in QR link so guests land on the public site, not the ops app.
# Set to the production URL in Vercel; unset falls back to this app's origin.
VITE_PUBLIC_WEB_URL=https://lsp-book.vercel.app

# Sentry error tracking (browser). Leave empty to keep it off; set in Vercel
# project env for production builds.
VITE_SENTRY_DSN=
