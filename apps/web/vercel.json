{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://lsp-api-p3zx.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://lsp-api-p3zx.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
