{
  "name": "lsp-web-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "npm run db:migrate --workspace=@lsp/api",
    "db:seed": "npm run db:seed --workspace=@lsp/api",
    "db:purge-test": "npm run db:purge-test --workspace=@lsp/api",
    "db:import-guests": "npm run db:import-guests --workspace=@lsp/api",
    "db:import-guests:apply": "npm run db:import-guests:apply --workspace=@lsp/api",
    "db:backfill-revenue": "npm run db:backfill-revenue --workspace=@lsp/api",
    "db:backfill-revenue:apply": "npm run db:backfill-revenue:apply --workspace=@lsp/api"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "prettier": "^3.5.3",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0"
  }
}
